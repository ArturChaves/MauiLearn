<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Foco em desktop: Mac Catalyst (macOS) e Windows (WinUI 3). -->
    <TargetFrameworks>net11.0-maccatalyst</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net11.0-windows10.0.19041.0</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <RootNamespace>MauiLearn</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <!--
      .NET MAUI 11: o inflador de XAML padrão é o SourceGen (gera C# a partir do XAML
      em tempo de compilação). 'XamlC' e 'Runtime' estão obsoletos.
      O XAML Hot Reload tem dois modos: Legacy (padrão) e SourceGen (incremental, requer
      IDE compatível). Para experimentar o novo modo, descomente:
    -->
    <!-- <MauiXamlHotReload>SourceGen</MauiXamlHotReload> -->

    <!--
      Descomente para habilitar recursos experimentais, como as
      "XAML C# Expressions" ({= ...}) do .NET MAUI 11 (veja a Aula 21).
    -->
    <!-- <EnablePreviewFeatures>true</EnablePreviewFeatures> -->

    <!-- Informações do app -->
    <ApplicationTitle>MauiLearn</ApplicationTitle>
    <ApplicationId>com.arturchaves.mauilearn</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <!-- Windows: executa sem empacotamento MSIX (F5 direto, mais simples para estudar). -->
    <WindowsPackageType>None</WindowsPackageType>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>

    <!-- ListView/TableView/Frame/Cells estão obsoletos, mas o app os ensina de propósito. -->
    <NoWarn>$(NoWarn);CS0618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Ícone do app -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />

    <!-- Splash screen -->
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />

    <!-- Imagens (SVG viram PNG em tempo de build pelo Resizetizer) -->
    <MauiImage Include="Resources\Images\*" />

    <!-- Fontes customizadas (coloque .ttf/.otf aqui e registre em MauiProgram) -->
    <MauiFont Include="Resources\Fonts\*.ttf;Resources\Fonts\*.otf" />

    <!-- Arquivos brutos (acessados via FileSystem.OpenAppPackageFileAsync) -->
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="11.0.0-rc.2.26504.105" />
  </ItemGroup>

  <ItemGroup>
    <!--
      O Inspetor de Propriedades e o Espião de Eventos usam reflexão sobre os controles.
      Mantemos os assemblies do MAUI inteiros caso o trimmer esteja ativo (ex.: Release no Mac).
    -->
    <TrimmerRootAssembly Include="Microsoft.Maui.Controls" />
    <TrimmerRootAssembly Include="Microsoft.Maui" />
    <TrimmerRootAssembly Include="Microsoft.Maui.Graphics" />
  </ItemGroup>

</Project>
