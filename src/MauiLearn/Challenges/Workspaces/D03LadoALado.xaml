<?xml version="1.0" encoding="utf-8" ?>
<!--
  DESAFIO 03 — Lado a lado
  As caixas estão empilhadas na vertical. Faça-as ficarem LADO A LADO:
    1. Troque VerticalStackLayout por HorizontalStackLayout (abertura E fechamento da tag!).
    2. Defina Spacing="12".
    3. Centralize o grupo horizontalmente: HorizontalOptions="Center".
  Mantenha x:Name="Caixas".
-->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/maui/global"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiLearn.Challenges.Workspaces.D03LadoALado">

  <VerticalStackLayout x:Name="Caixas" Spacing="2" VerticalOptions="Center">
    <BoxView Color="#512BD4" WidthRequest="80" HeightRequest="80" />
    <BoxView Color="#D600AA" WidthRequest="80" HeightRequest="80" />
    <BoxView Color="#2E9D5B" WidthRequest="80" HeightRequest="80" />
  </VerticalStackLayout>

</ContentView>
