<?xml version="1.0" encoding="utf-8" ?>
<!--
  Catálogo: busca + filtros + CollectionView AGRUPADA em grade.
  Repare: x:DataType em cada nível (página → ViewModel; DataTemplate → modelo do item).
  Isso ativa "compiled bindings": rápidos e verificados em tempo de compilação.
-->
<AppPage xmlns="http://schemas.microsoft.com/dotnet/maui/global"
         xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
         x:Class="MauiLearn.Pages.CatalogPage"
         x:DataType="CatalogViewModel"
         Title="Catálogo de Componentes">

  <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="28,20,28,0" RowSpacing="12">

    <VerticalStackLayout Spacing="2">
      <Label Text="Catálogo de Componentes" Style="{StaticResource H1}" />
      <Label Style="{StaticResource Caption}">
        <Label.FormattedText>
          <FormattedString>
            <Span Text="{Binding ResultCount}" FontAttributes="Bold" />
            <Span Text=" de " />
            <Span Text="{Binding TotalCount}" />
            <Span Text=" componentes · clique em um para abrir o laboratório interativo (prévia + inspetor de propriedades + eventos)" />
          </FormattedString>
        </Label.FormattedText>
      </Label>
    </VerticalStackLayout>

    <SearchBar x:Name="Search" Grid.Row="1"
               Placeholder="Buscar por nome, descrição ou propriedade (ex.: CornerRadius)…"
               Text="{Binding SearchText}" />

    <!-- Chips de filtro: BindableLayout num FlexLayout que quebra linha -->
    <FlexLayout Grid.Row="2" Wrap="Wrap" BindableLayout.ItemsSource="{Binding Filters}">
      <BindableLayout.ItemTemplate>
        <DataTemplate x:DataType="CategoryFilter">
          <Border Padding="12,6" Margin="0,0,6,6" StrokeShape="RoundRectangle 16" StrokeThickness="1">
            <Border.GestureRecognizers>
              <TapGestureRecognizer Command="{Binding SelectFilterCommand, Source={RelativeSource AncestorType={x:Type CatalogViewModel}}, x:DataType=CatalogViewModel}"
                                    CommandParameter="{Binding .}" />
            </Border.GestureRecognizers>
            <Border.Triggers>
              <!-- DataTrigger: muda a aparência quando IsSelected = True -->
              <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
              </DataTrigger>
            </Border.Triggers>
            <Label Text="{Binding Label}" FontSize="13">
              <Label.Triggers>
                <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                  <Setter Property="TextColor" Value="{AppThemeBinding Light=White, Dark={StaticResource PrimaryDarkText}}" />
                </DataTrigger>
              </Label.Triggers>
            </Label>
          </Border>
        </DataTemplate>
      </BindableLayout.ItemTemplate>
    </FlexLayout>

    <CollectionView x:Name="Items" Grid.Row="3"
                    ItemsSource="{Binding Groups}"
                    IsGrouped="True"
                    SelectionMode="Single"
                    SelectionChanged="OnSelectionChanged">
      <CollectionView.ItemsLayout>
        <GridItemsLayout x:Name="GridLayout" Orientation="Vertical" Span="3"
                         HorizontalItemSpacing="12" VerticalItemSpacing="12" />
      </CollectionView.ItemsLayout>

      <CollectionView.EmptyView>
        <VerticalStackLayout Padding="40" Spacing="8" HorizontalOptions="Center">
          <Label Text="🔎" FontSize="48" HorizontalOptions="Center" />
          <Label Text="Nenhum componente encontrado." HorizontalOptions="Center" />
        </VerticalStackLayout>
      </CollectionView.EmptyView>

      <CollectionView.GroupHeaderTemplate>
        <DataTemplate x:DataType="ComponentGroup">
          <HorizontalStackLayout Spacing="8" Padding="0,18,0,6">
            <Label Text="{Binding Icon}" FontSize="20" />
            <Label Text="{Binding Name}" Style="{StaticResource H3}" Margin="0" VerticalOptions="Center" />
            <Label Text="{Binding Count, StringFormat='({0})'}" Style="{StaticResource Caption}" VerticalOptions="Center" />
          </HorizontalStackLayout>
        </DataTemplate>
      </CollectionView.GroupHeaderTemplate>

      <CollectionView.ItemTemplate>
        <DataTemplate x:DataType="ComponentInfo">
          <Border Style="{StaticResource Card}" Padding="14" HeightRequest="128">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup Name="CommonStates">
                <VisualState Name="Normal" />
                <VisualState Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                    <Setter Property="Scale" Value="1.015" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState Name="Selected">
                  <VisualState.Setters>
                    <Setter Property="Stroke" Value="{StaticResource Magenta}" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Grid RowDefinitions="Auto,*" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" RowSpacing="6">
              <Label Text="{Binding Icon}" FontSize="26" VerticalOptions="Center" />
              <Label Grid.Column="1" Text="{Binding Name}" FontAttributes="Bold" FontSize="15"
                     VerticalOptions="Center" LineBreakMode="TailTruncation" />
              <Border Grid.Column="2" Padding="6,2" StrokeThickness="0" StrokeShape="RoundRectangle 6"
                      BackgroundColor="{StaticResource Secondary}"
                      IsVisible="{Binding Badge, Converter={StaticResource IsNotEmpty}}">
                <Label Text="{Binding Badge}" Style="{StaticResource ChipLabel}" />
              </Border>
              <Label Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding Summary}" FontSize="13"
                     MaxLines="3" LineBreakMode="TailTruncation" Opacity="0.85" />
            </Grid>
          </Border>
        </DataTemplate>
      </CollectionView.ItemTemplate>

      <CollectionView.Footer>
        <BoxView HeightRequest="24" Color="Transparent" />
      </CollectionView.Footer>
    </CollectionView>
  </Grid>
</AppPage>
