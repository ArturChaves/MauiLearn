<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/maui/global"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiLearn.Lessons.L08Mvvm"
             x:DataType="MvvmLessonViewModel">
  <VerticalStackLayout Spacing="10">

    <Label Style="{StaticResource Body}"
           Text="MVVM (Model-View-ViewModel) separa a interface (View, em XAML) da lógica e do estado (ViewModel, em C#). A View só faz bindings; o ViewModel não conhece nenhum controle. Resultado: código testável, reutilizável e telas fáceis de mudar." />

    <Grid ColumnDefinitions="*,Auto,*,Auto,*" ColumnSpacing="8" Margin="0,6">
      <Border Style="{StaticResource Card}">
        <VerticalStackLayout>
          <Label Text="View" FontAttributes="Bold" HorizontalOptions="Center" />
          <Label Text="XAML: o que aparece" FontSize="12" HorizontalOptions="Center" />
        </VerticalStackLayout>
      </Border>
      <Label Grid.Column="1" Text="⇄ Binding" VerticalOptions="Center" FontSize="12" />
      <Border Grid.Column="2" Style="{StaticResource Card}">
        <VerticalStackLayout>
          <Label Text="ViewModel" FontAttributes="Bold" HorizontalOptions="Center" />
          <Label Text="Estado + Commands" FontSize="12" HorizontalOptions="Center" />
        </VerticalStackLayout>
      </Border>
      <Label Grid.Column="3" Text="→ usa" VerticalOptions="Center" FontSize="12" />
      <Border Grid.Column="4" Style="{StaticResource Card}">
        <VerticalStackLayout>
          <Label Text="Model / Serviços" FontAttributes="Bold" HorizontalOptions="Center" />
          <Label Text="Dados e regras de negócio" FontSize="12" HorizontalOptions="Center" />
        </VerticalStackLayout>
      </Border>
    </Grid>

    <!-- ===== 1 ===== -->
    <Label Text="1. INotifyPropertyChanged" Style="{StaticResource H2}" />
    <Label Style="{StaticResource Body}"
           Text="Bindings só sabem que algo mudou se o objeto disparar o evento PropertyChanged. A base ObservableObject deste projeto (Core/ObservableObject.cs) encapsula isso:" />
    <CodeBlock Language="csharp"><![CDATA[
      public abstract class ObservableObject : INotifyPropertyChanged
      {
          public event PropertyChangedEventHandler? PropertyChanged;

          protected void OnPropertyChanged([CallerMemberName] string? name = null) =>
              PropertyChanged?.Invoke(this, new PropertyChangedEventArgs(name));

          protected bool SetProperty<T>(ref T field, T value, [CallerMemberName] string? name = null)
          {
              if (EqualityComparer<T>.Default.Equals(field, value)) return false;
              field = value;
              OnPropertyChanged(name);
              return true;
          }
      }
    ]]></CodeBlock>

    <!-- ===== 2 ===== -->
    <Label Text="2. Commands (ICommand)" Style="{StaticResource H2}" />
    <Label Style="{StaticResource Body}"
           Text="Em vez de eventos Clicked no code-behind, o botão chama um ICommand do ViewModel. CanExecute habilita/desabilita o botão automaticamente — repare no botão − e no Zerar abaixo." />
    <CodeBlock Language="csharp"><![CDATA[
      public sealed class CounterViewModel : ObservableObject
      {
          private int _count;

          public CounterViewModel()
          {
              IncrementCommand = new RelayCommand(() => Count++);
              DecrementCommand = new RelayCommand(() => Count--, () => Count > 0);   // CanExecute
          }

          public int Count
          {
              get => _count;
              set
              {
                  if (!SetProperty(ref _count, value)) return;
                  OnPropertyChanged(nameof(Message));            // propriedade dependente
                  DecrementCommand.NotifyCanExecuteChanged();    // reavalia o botão
              }
          }

          public string Message => Count == 0 ? "Clique em +" : $"Você clicou {Count} vez(es)";
          public RelayCommand IncrementCommand { get; }
          public RelayCommand DecrementCommand { get; }
      }
    ]]></CodeBlock>
    <CodeBlock Language="xaml"><![CDATA[
      <VerticalStackLayout x:DataType="vm:CounterViewModel">
          <Label Text="{Binding Count}" FontSize="48" />
          <Label Text="{Binding Message}" />
          <Button Text="−" Command="{Binding DecrementCommand}" />
          <Button Text="+" Command="{Binding IncrementCommand}" />
      </VerticalStackLayout>
    ]]></CodeBlock>

    <!--
      BindingContext deste bloco = Counter (sub-ViewModel).
      Nuance: o binding de BindingContext fica no PAI (ainda com x:DataType=MvvmLessonViewModel);
      o x:DataType novo vai no filho.
    -->
    <Border Style="{StaticResource DemoArea}" BindingContext="{Binding Counter}">
      <VerticalStackLayout x:DataType="CounterViewModel" Spacing="8" HorizontalOptions="Center">
        <Label Text="{Binding Count}" FontSize="56" FontAttributes="Bold" HorizontalOptions="Center"
               TextColor="{StaticResource Primary}" />
        <Label Text="{Binding Message}" HorizontalOptions="Center" />
        <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
          <Button Text="−" Command="{Binding DecrementCommand}" WidthRequest="60" />
          <Button Text="+" Command="{Binding IncrementCommand}" WidthRequest="60" />
          <Button Text="Zerar" Command="{Binding ResetCommand}" Style="{StaticResource SecondaryButton}" />
        </HorizontalStackLayout>
      </VerticalStackLayout>
    </Border>

    <!-- ===== 3 ===== -->
    <Label Text="3. Coleções: ObservableCollection e comandos com parâmetro" Style="{StaticResource H2}" />
    <Label Style="{StaticResource Body}"
           Text="List&lt;T&gt; não avisa quando itens entram ou saem. ObservableCollection&lt;T&gt; dispara CollectionChanged e a lista na tela se atualiza. Para saber QUAL item excluir, passamos o próprio item como CommandParameter." />
    <CodeBlock Language="xaml"><![CDATA[
      <CollectionView ItemsSource="{Binding Items}">
          <CollectionView.ItemTemplate>
              <DataTemplate x:DataType="vm:TodoItem">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                      <CheckBox IsChecked="{Binding Done}" />
                      <Label Grid.Column="1" Text="{Binding Title}" />
                      <!-- O comando está no ViewModel PAI: buscamos o ancestral -->
                      <Button Grid.Column="2" Text="🗑"
                              Command="{Binding RemoveCommand, Source={RelativeSource AncestorType={x:Type vm:TodoViewModel}}, x:DataType=vm:TodoViewModel}"
                              CommandParameter="{Binding .}" />
                  </Grid>
              </DataTemplate>
          </CollectionView.ItemTemplate>
      </CollectionView>
    ]]></CodeBlock>

    <Border Style="{StaticResource DemoArea}" BindingContext="{Binding Todo}">
      <Grid x:DataType="TodoViewModel" RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
          <Entry Text="{Binding NewTitle}" Placeholder="Nova tarefa… (Enter adiciona)" ReturnCommand="{Binding AddCommand}" />
          <Button Grid.Column="1" Text="Adicionar" Command="{Binding AddCommand}" />
          <Button Grid.Column="2" Text="Limpar concluídas" Command="{Binding ClearDoneCommand}" Style="{StaticResource SecondaryButton}" />
        </Grid>
        <VerticalStackLayout Grid.Row="1" BindableLayout.ItemsSource="{Binding Items}" Spacing="4">
          <BindableLayout.EmptyView>
            <Label Text="Nenhuma tarefa 🎉" Opacity="0.6" />
          </BindableLayout.EmptyView>
          <BindableLayout.ItemTemplate>
            <DataTemplate x:DataType="TodoItem">
              <Border Style="{StaticResource Card}" Padding="8,4">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                  <CheckBox IsChecked="{Binding Done}" VerticalOptions="Center" />
                  <Label Grid.Column="1" Text="{Binding Title}" VerticalOptions="Center">
                    <Label.Triggers>
                      <DataTrigger TargetType="Label" Binding="{Binding Done}" Value="True">
                        <Setter Property="TextDecorations" Value="Strikethrough" />
                        <Setter Property="Opacity" Value="0.5" />
                      </DataTrigger>
                    </Label.Triggers>
                  </Label>
                  <Button Grid.Column="2" Text="🗑" Padding="8,2" Style="{StaticResource SecondaryButton}"
                          Command="{Binding RemoveCommand, Source={RelativeSource AncestorType={x:Type TodoViewModel}}, x:DataType=TodoViewModel}"
                          CommandParameter="{Binding .}" />
                </Grid>
              </Border>
            </DataTemplate>
          </BindableLayout.ItemTemplate>
        </VerticalStackLayout>
        <Label Grid.Row="2" Text="{Binding Items.Count, StringFormat='{0} tarefa(s)'}" Style="{StaticResource Caption}" />
      </Grid>
    </Border>

    <TipCard Kind="Nuance">
      Items.Count na legenda acima atualiza porque ObservableCollection também notifica PropertyChanged("Count"). Já a lista em si é atualizada via CollectionChanged.
    </TipCard>

    <!-- ===== 4 ===== -->
    <Label Text="4. CommunityToolkit.Mvvm: menos código repetitivo" Style="{StaticResource H2}" />
    <Label Style="{StaticResource Body}"
           Text="Depois de entender o mecanismo, em projetos reais use o pacote CommunityToolkit.Mvvm. Source generators escrevem o boilerplate para você:" />
    <CodeBlock Language="csharp"><![CDATA[
      // dotnet add package CommunityToolkit.Mvvm
      public partial class CounterViewModel : ObservableObject
      {
          [ObservableProperty]
          [NotifyPropertyChangedFor(nameof(Message))]
          [NotifyCanExecuteChangedFor(nameof(DecrementCommand))]
          public partial int Count { get; set; }

          public string Message => $"Você clicou {Count} vez(es)";

          [RelayCommand]
          private void Increment() => Count++;          // gera IncrementCommand

          [RelayCommand(CanExecute = nameof(CanDecrement))]
          private void Decrement() => Count--;

          private bool CanDecrement() => Count > 0;
      }
    ]]></CodeBlock>

    <TipCard Kind="Tip">
      Registre ViewModels e páginas na injeção de dependência (builder.Services.AddTransient&lt;MinhaPage&gt;() e AddTransient&lt;MeuViewModel&gt;()) e receba o ViewModel pelo construtor da página: public MinhaPage(MeuViewModel vm) { BindingContext = vm; }.
    </TipCard>
    <TipCard Kind="New">
      MessagingCenter deixou de ser público no .NET MAUI 10+. Para comunicação entre ViewModels, use WeakReferenceMessenger do CommunityToolkit.Mvvm.
    </TipCard>
  </VerticalStackLayout>
</ContentView>
